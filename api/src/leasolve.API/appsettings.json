{
  "DatabaseSettings": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "ScalarSettings": {
    "Title": "Leasolve API"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/leasolve-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "shared": true,
          "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
          ]
        }
      }
    ]
  },
  "DataSeederSettings": {
    "SeedData": false,
    "AdminUser": {
      "Email": "",
      "Password": ""
    }
  }
}